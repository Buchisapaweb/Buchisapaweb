# ==============================================================================
# BUCHISAPA RESTAURANTE - VARIABLES DE ENTORNO
# ==============================================================================

# --- Supabase (Configuración para Next.js / Servidor) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (Clave Secreta del Servidor - Superadmin / Bypasses RLS) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase (Compatibilidad Frontend / Vite) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Google OAuth (Client ID para Login Google en el Frontend) ---
VITE_GOOGLE_CLIENT_ID=

# --- Base de Datos Relacional / PostgreSQL (Opcional / Cloud SQL) ---
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=