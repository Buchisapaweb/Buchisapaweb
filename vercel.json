{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/index.ts": {
      "includeFiles": "backend/data/**"
    }
  },
  "rewrites": [
    {
      "source": "/admin/index.php",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/dashboard",
      "destination": "/admin/dashboard.html"
    },
    {
      "source": "/admin/productos",
      "destination": "/admin/productos.html"
    },
    {
      "source": "/admin/clientes",
      "destination": "/admin/clientes.html"
    },
    {
      "source": "/admin/pedidos",
      "destination": "/admin/pedidos.html"
    },
    {
      "source": "/admin/ticket",
      "destination": "/admin/ticket.html"
    },
    {
      "source": "/admin/configuracion",
      "destination": "/admin/configuracion.html"
    },
    {
      "source": "/php-admin(.*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
