{
  "name": "buchisapa-restaurante",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "desarrollo": "tsx servidor.ts",
    "construir": "vite build && node scripts/compilar-html.js && esbuild servidor.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/servidor.cjs",
    "iniciar": "node dist/servidor.cjs",
    "verificar": "tsc --noEmit",
    "dev": "tsx servidor.ts",
    "build": "vite build && esbuild servidor.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/servidor.cjs",
    "start": "node dist/servidor.cjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@tailwindcss/vite": "^4.3.3",
    "express": "^5.2.1",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
